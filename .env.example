# ── Backend Environment Variables ──
FRONTDESK_SECRET_KEY=your-secure-random-key-here
REQUIRE_AUTH=false
FRONTDESK_CORS_ORIGINS=https://your-app.vercel.app,http://localhost:5173
# DATABASE_URL defaults to SQLite in backend/frontdesk.db

